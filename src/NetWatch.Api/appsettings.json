{
  "ConnectionStrings": {
    "Default": "Data Source=netwatch.db"
  },

  "Database": {
    "Provider": "Sqlite",
    "MigrateOnStartup": true,
    "SeedOnStartup": true
  },

  "Monitoring": {
    "Enabled": true,
    "TickSeconds": 5,
    "MaxConcurrentChecks": 20,
    "MaxChecksPerTick": 200,
    "ResultRetentionDays": 30,
    "RetentionSweepHours": 6,
    "RetentionBatchSize": 5000
  },

  "Jwt": {
    "Issuer": "NetWatch",
    "Audience": "NetWatch.Client",
    "SigningKey": "",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7
  },

  "Cors": {
    "AllowedOrigins": [ "http://localhost:4200" ]
  },

  "Seed": {
    "AdminEmail": "admin@netwatch.local",
    "AdminFullName": "NetWatch Administrator",
    "AdminPassword": ""
  },

  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
        "System.Net.Http.HttpClient": "Warning"
      }
    },
    "WriteTo": [ { "Name": "Console" } ],
    "Enrich": [ "FromLogContext" ]
  },

  "AllowedHosts": "*"
}
