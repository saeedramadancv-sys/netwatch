{
  // Development-only overrides. This file is read only when ASPNETCORE_ENVIRONMENT is
  // "Development", so nothing here reaches a deployed instance.
  //
  // Jwt:SigningKey is deliberately absent: in Development the application generates a
  // random key at startup, so no signing material is ever committed. See Program.cs.
  //
  // The seed password below exists so a fresh clone can log in immediately. In any other
  // environment DbInitializer refuses to create an administrator unless Seed:AdminPassword
  // is supplied out of band (environment variable, user-secrets, or a secret store).
  "Seed": {
    "AdminEmail": "admin@netwatch.local",
    "AdminPassword": "NetWatch#Dev1"
  },

  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Information"
      }
    }
  }
}
