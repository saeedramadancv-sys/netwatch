# Copy to .env before running docker compose. .env is gitignored.
#
# Generate a signing key with:
#   openssl rand -base64 48
# or, without openssl:
#   dotnet run --project src/NetWatch.Api  (Development generates an ephemeral one)

JWT_SIGNING_KEY=replace-me-with-at-least-32-random-characters

MSSQL_SA_PASSWORD=replace-me-Strong1!
ADMIN_EMAIL=admin@netwatch.local
ADMIN_PASSWORD=replace-me-Strong1!
